<UserControl x:Class="Rekey.App.Views.DiagnosticsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:Rekey.App">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,16" MaxWidth="640" HorizontalAlignment="Left">
      <ui:ToggleSwitch Content="{x:Static app:Strings.KeyboardWatchdog}"
                       IsChecked="{Binding KeyboardWatchdogEnabled}"
                       Margin="0,0,0,16" />
      <ui:ToggleSwitch Content="{x:Static app:Strings.RestartAfterFreeze}"
                       IsChecked="{Binding RestartAfterFreezeEnabled}"
                       Margin="0,0,0,24" />
      <ui:ToggleSwitch Content="{x:Static app:Strings.StatisticsEnabled}"
                       IsChecked="{Binding StatisticsEnabled}"
                       Margin="0,0,0,16" />
      <ui:ToggleSwitch Content="{x:Static app:Strings.AnalysisLogEnabled}"
                       IsChecked="{Binding AnalysisLogEnabled}"
                       Margin="0,0,0,4" />
      <TextBlock Text="{x:Static app:Strings.AnalysisLogNote}"
                 Style="{StaticResource HintText}"
                 Margin="0,0,0,16"
                 Focusable="True" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
        <ui:Button x:Name="StatisticsButton"
                   Content="{x:Static app:Strings.OpenStatistics}"
                   Margin="0,0,8,0" />
        <ui:Button x:Name="ExportButton" Content="{x:Static app:Strings.OpenExport}" />
      </StackPanel>
      <TextBlock Text="{x:Static app:Strings.PrivacyNote}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,24"
                 Focusable="True" />
      <ui:ToggleSwitch Content="{x:Static app:Strings.CrashReportsEnabled}"
                       IsChecked="{Binding CrashReportsEnabled}"
                       Margin="0,0,0,16" />
      <ui:ToggleSwitch Content="{x:Static app:Strings.UsageDigestEnabled}"
                       IsChecked="{Binding UsageDigestEnabled}"
                       Margin="0,0,0,4" />
      <TextBlock Text="{x:Static app:Strings.TelemetryNote}"
                 Style="{StaticResource HintText}"
                 Margin="0,0,0,8"
                 Focusable="True" />
      <Expander x:Name="SentExpander"
                Header="{x:Static app:Strings.ShowWhatWasSent}"
                Margin="0,0,0,24">
        <TextBox x:Name="SentText"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 FontFamily="Consolas"
                 MaxHeight="240"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{x:Static app:Strings.ShowWhatWasSent}" />
      </Expander>
      <TextBlock Text="{x:Static app:Strings.SignUpTitle}"
                 Style="{StaticResource SectionText}"
                 Margin="0,0,0,8" />
      <StackPanel x:Name="SignUp">
        <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{x:Static app:Strings.SignUpEmail}"
                    AutomationProperties.Name="{x:Static app:Strings.SignUpEmail}"
                    Margin="0,0,0,8" />
        <CheckBox Content="{x:Static app:Strings.SignUpNewVersions}"
                  IsChecked="{Binding NewVersions}" />
        <CheckBox Content="{x:Static app:Strings.SignUpReportedProblems}"
                  IsChecked="{Binding ReportedProblems}"
                  Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal">
          <ui:Button x:Name="SignUpButton"
                     Content="{x:Static app:Strings.SignUpSubmit}"
                     Margin="0,0,12,0" />
          <TextBlock x:Name="SignUpStatus"
                     VerticalAlignment="Center"
                     Focusable="True"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
