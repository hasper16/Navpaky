<UserControl x:Class="Rekey.App.Views.DiagnosticsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:Rekey.App">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,16" MaxWidth="640" HorizontalAlignment="Left">
      <ui:ToggleSwitch Content="{x:Static app:Strings.KeyboardWatchdog}"
                       IsChecked="{Binding KeyboardWatchdogEnabled}"
                       Margin="0,0,0,16" />
      <ui:ToggleSwitch Content="{x:Static app:Strings.RestartAfterFreeze}"
                       IsChecked="{Binding RestartAfterFreezeEnabled}"
                       Margin="0,0,0,24" />
      <TextBlock Text="{x:Static app:Strings.PrivacyNote}"
                 TextWrapping="Wrap"
                 Focusable="True" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
