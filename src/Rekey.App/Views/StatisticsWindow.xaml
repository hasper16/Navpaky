<ui:FluentWindow x:Class="Rekey.App.Views.StatisticsWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Rekey.App.Localization"
                 Title="{l:Loc StatisticsTitle}"
                 Width="560"
                 SizeToContent="Height"
                 MinWidth="420"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Grid Grid.IsSharedSizeScope="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="TitleBar"
                 Title="{l:Loc StatisticsTitle}"
                 ShowMaximize="False" />
    <!-- The window is as tall as its rows, up to the work area; the rest scrolls. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,8,24,24">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Today" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Month" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1"
                   Text="{l:Loc StatToday}"
                   FontWeight="SemiBold"
                   TextAlignment="Right"
                   Margin="16,0,0,0" />
        <TextBlock Grid.Column="2"
                   Text="{l:Loc StatMonth}"
                   FontWeight="SemiBold"
                   TextAlignment="Right"
                   Margin="24,0,0,0" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,3" Focusable="True"
                  AutomationProperties.Name="{Binding Name}"
                  AutomationProperties.HelpText="{Binding Month}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Today" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Month" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Today}"
                         TextAlignment="Right"
                         Margin="16,0,0,0" />
              <TextBlock Grid.Column="2"
                         Text="{Binding Month}"
                         TextAlignment="Right"
                         Margin="24,0,0,0" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{l:Loc StatisticsNote}"
                 Style="{StaticResource HintText}"
                 Margin="0,16,0,16"
                 Focusable="True" />
      <ui:Button x:Name="RefreshButton"
                 Content="{l:Loc Refresh}"
                 HorizontalAlignment="Left" />
    </StackPanel>
    </ScrollViewer>
  </Grid>
</ui:FluentWindow>
