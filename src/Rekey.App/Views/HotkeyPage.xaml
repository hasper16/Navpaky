<UserControl x:Class="Rekey.App.Views.HotkeyPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Rekey.App">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,16" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock x:Name="Intro"
                 Text="{x:Static app:Strings.HotkeyIntro}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,16" />
      <StackPanel x:Name="Options" AutomationProperties.LabeledBy="{Binding ElementName=Intro}" />
      <StackPanel Orientation="Horizontal" Margin="28,4,0,16">
        <TextBox x:Name="Recorder"
                 MinWidth="200"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="False"
                 AutomationProperties.Name="{x:Static app:Strings.HotkeyCustom}" />
        <Button x:Name="Record"
                Content="{x:Static app:Strings.HotkeyRecord}"
                Margin="8,0,0,0" />
      </StackPanel>
      <Border x:Name="Conflict"
              Visibility="Collapsed"
              BorderThickness="1"
              BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
              Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
              CornerRadius="4"
              Padding="12">
        <StackPanel>
          <TextBlock x:Name="ConflictText" TextWrapping="Wrap" Focusable="True" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="UseAnyway" Content="{x:Static app:Strings.HotkeyUseAnyway}" />
            <Button x:Name="PickAnother"
                    Content="{x:Static app:Strings.HotkeyPickAnother}"
                    Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
