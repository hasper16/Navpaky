<UserControl x:Class="Rekey.App.Views.GeneralPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:Rekey.App">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,16" MaxWidth="640" HorizontalAlignment="Left">
      <ui:ToggleSwitch Content="{x:Static app:Strings.LaunchAtSignIn}"
                       IsChecked="{Binding LaunchAtSignIn}"
                       Margin="0,0,0,16" />
      <ui:ToggleSwitch Content="{x:Static app:Strings.ShowCursorIndicator}"
                       IsChecked="{Binding ShowCursorIndicator}" />
      <TextBlock Text="{x:Static app:Strings.ShowCursorIndicatorHint}"
                 Style="{StaticResource HintText}"
                 Margin="0,4,0,16" />
      <ui:ToggleSwitch x:Name="PlaySound"
                       Content="{x:Static app:Strings.PlaySwitchSound}"
                       IsChecked="{Binding PlaySwitchSound}"
                       Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <Label x:Name="SoundLabel"
               Content="{x:Static app:Strings.SwitchSoundChoice}"
               Target="{Binding ElementName=Sounds}"
               VerticalAlignment="Center"
               Margin="0,0,12,0" />
        <ComboBox x:Name="Sounds"
                  MinWidth="160"
                  AutomationProperties.LabeledBy="{Binding ElementName=SoundLabel}"
                  SelectedValue="{Binding SwitchSound}"
                  SelectedValuePath="Tag" />
        <Button x:Name="Preview"
                Content="{x:Static app:Strings.PreviewSound}"
                Margin="8,0,0,0" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
