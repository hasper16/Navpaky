<UserControl x:Class="Rekey.App.Views.AboutPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Rekey.App">
  <StackPanel Margin="24,16" HorizontalAlignment="Left">
    <Image x:Name="Mark"
           Width="64"
           Height="64"
           HorizontalAlignment="Left"
           Margin="0,0,0,16"
           AutomationProperties.Name="Rekey" />
    <TextBlock Text="Rekey" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="{x:Static app:Strings.AboutTagline}" Margin="0,4,0,8" Focusable="True" />
    <TextBlock x:Name="Version" Style="{StaticResource HintText}" Focusable="True" />
  </StackPanel>
</UserControl>
