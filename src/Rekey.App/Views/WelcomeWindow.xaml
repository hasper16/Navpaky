<ui:FluentWindow x:Class="Rekey.App.Views.WelcomeWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:Rekey.App"
                 Title="{x:Static app:Strings.WelcomeTitle}"
                 Width="640"
                 Height="720"
                 MinWidth="480"
                 MinHeight="420"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Shown" />
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="{x:Static app:Strings.WelcomeTitle}" />
    <!-- One scrolling page rather than a wizard, so the user can skim (design D1). -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="24,8,24,16">
        <Image x:Name="Mark"
               Width="64"
               Height="64"
               HorizontalAlignment="Left"
               Margin="0,0,0,12"
               AutomationProperties.Name="Rekey" />
        <TextBlock Text="{x:Static app:Strings.WelcomeDescription}"
                   TextWrapping="Wrap"
                   FontSize="16"
                   Focusable="True"
                   Margin="0,0,0,8" />
        <TextBlock Text="{x:Static app:Strings.WelcomeUndo}"
                   Style="{StaticResource HintText}"
                   Focusable="True"
                   Margin="0,0,0,24" />

        <TextBlock Text="{x:Static app:Strings.WelcomePrivacyTitle}"
                   Style="{StaticResource SectionText}" />
        <TextBlock Text="{x:Static app:Strings.WelcomePrivacy}"
                   TextWrapping="Wrap"
                   Focusable="True"
                   Margin="0,0,0,24" />

        <TextBlock Text="{x:Static app:Strings.WelcomeTryItTitle}"
                   Style="{StaticResource SectionText}" />
        <Border Visibility="{Binding NeedsAnotherLayout, Converter={StaticResource Shown}}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="{x:Static app:Strings.WelcomeOneLayout}"
                       TextWrapping="Wrap"
                       Focusable="True" />
            <Button x:Name="LanguageSettings"
                    Content="{x:Static app:Strings.WelcomeLanguageSettings}"
                    Margin="0,12,0,0" />
          </StackPanel>
        </Border>
        <TextBlock x:Name="TryItHint" TextWrapping="Wrap" Focusable="True" Margin="0,0,0,8" />
        <TextBox x:Name="TryIt"
                 AutomationProperties.Name="{x:Static app:Strings.WelcomeTryItField}"
                 AutomationProperties.HelpText="{Binding Text, ElementName=TryItHint}" />
        <TextBlock x:Name="TryItWorked"
                   Text="{x:Static app:Strings.WelcomeTryItWorked}"
                   Visibility="{Binding TryItWorked, Converter={StaticResource Shown}}"
                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                   TextWrapping="Wrap"
                   Focusable="True"
                   AutomationProperties.LiveSetting="Polite"
                   Margin="0,8,0,0" />

        <TextBlock Text="{x:Static app:Strings.WelcomeChoicesTitle}"
                   Style="{StaticResource SectionText}"
                   Margin="0,24,0,8" />
        <ui:ToggleSwitch Content="{x:Static app:Strings.AutoCorrection}"
                         IsChecked="{Binding AutoCorrectionEnabled}"
                         Margin="0,0,0,12" />
        <ui:ToggleSwitch Content="{x:Static app:Strings.LaunchAtSignIn}"
                         IsChecked="{Binding LaunchAtSignIn}"
                         Margin="0,0,0,16" />
        <TextBlock Text="{x:Static app:Strings.WelcomeHotkeyTitle}"
                   Style="{StaticResource SectionText}" />
        <!-- The Hotkey page itself, so the choice works the same as in Settings. -->
        <ContentControl x:Name="Hotkey" Focusable="False" Margin="-24,-16,-24,0" />

        <TextBlock Text="{x:Static app:Strings.WelcomeTrayTitle}"
                   Style="{StaticResource SectionText}"
                   Margin="0,8,0,8" />
        <TextBlock Text="{x:Static app:Strings.WelcomeTrayTip}"
                   TextWrapping="Wrap"
                   Focusable="True" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Padding="24,12">
      <ui:Button x:Name="Done"
                 Content="{x:Static app:Strings.WelcomeDone}"
                 Appearance="Primary"
                 HorizontalAlignment="Right"
                 MinWidth="120" />
    </Border>
  </Grid>
</ui:FluentWindow>
