<ui:FluentWindow x:Class="Rekey.App.Views.ExportWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:Rekey.App"
                 Title="{x:Static app:Strings.ExportTitle}"
                 Width="720"
                 Height="560"
                 MinWidth="480"
                 MinHeight="360"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="TitleBar" Title="{x:Static app:Strings.ExportTitle}" />
    <StackPanel Grid.Row="1" Margin="24,8,24,8">
      <TextBlock Text="{x:Static app:Strings.ExportNote}"
                 Style="{StaticResource HintText}"
                 Margin="0,0,0,8"
                 Focusable="True" />
      <CheckBox Content="{x:Static app:Strings.ExportIncludeLog}"
                IsChecked="{Binding IncludeAnalysisLog}" />
    </StackPanel>
    <TextBox x:Name="PreviewBox"
             Grid.Row="2"
             Margin="24,0,24,8"
             Text="{Binding Preview, Mode=OneWay}"
             IsReadOnly="True"
             FontFamily="Consolas"
             TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             AutomationProperties.Name="{x:Static app:Strings.ExportTitle}" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="24,0,24,24">
      <ui:Button x:Name="SaveButton"
                 Content="{x:Static app:Strings.ExportSave}"
                 Appearance="Primary"
                 Margin="0,0,8,0" />
      <ui:Button x:Name="CopyButton" Content="{x:Static app:Strings.ExportCopy}" />
      <TextBlock x:Name="Status"
                 VerticalAlignment="Center"
                 Margin="16,0,0,0"
                 Style="{StaticResource HintText}"
                 Focusable="True" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
