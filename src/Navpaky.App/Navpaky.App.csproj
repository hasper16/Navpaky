<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(DotNetTargetFramework)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <NeutralLanguage>en</NeutralLanguage>
    <StartupObject>Navpaky.App.Program</StartupObject>
    <Product>Navpaky</Product>
    <AssemblyTitle>Navpaky</AssemblyTitle>
    <ApplicationIcon>Navpaky.ico</ApplicationIcon>
    <!-- Managed exceptions only: no native crash minidumps (add-telemetry, design D1). -->
    <SentryNative>false</SentryNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" />
    <PackageReference Include="Sentry" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Strings.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedClassName="Strings"
                      PublicClass="true"
                      StronglyTypedNamespace="Navpaky.App"
                      StronglyTypedFileName="Strings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sounds\*.wav" LogicalName="Navpaky.Sounds.%(Filename).wav" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Navpaky.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Navpaky.Win32\Navpaky.Win32.csproj" />
  </ItemGroup>

  <!-- Strings.Designer.cs is generated from Strings.resx and kept in the repository: the XAML
       compiler's temporary assembly sees only files that exist when the project loads. The
       build regenerates it first and keeps one copy in the compilation. -->
  <Target Name="GenerateStringsBeforeMarkup"
          BeforeTargets="MarkupCompilePass1"
          DependsOnTargets="PrepareResourceNames;CoreResGen">
    <ItemGroup>
      <Compile Remove="Strings.Designer.cs" />
      <Compile Include="Strings.Designer.cs" />
    </ItemGroup>
  </Target>

</Project>
