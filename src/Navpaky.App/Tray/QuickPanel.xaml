<Window x:Class="Navpaky.App.Tray.QuickPanel"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:Navpaky.App.Localization"
        xmlns:v="clr-namespace:Navpaky.App.Views"
        xmlns:vm="clr-namespace:Navpaky.App.ViewModels"
        xmlns:det="clr-namespace:Navpaky.Core.Detection;assembly=Navpaky.Core"
        Title="{l:Loc QuickPanelTitle}"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
  <!-- The quick panel of the approved prototype (design D5 of redesign-visual-identity, layout
       per fix-redesign-findings), opened by a left click on the tray icon. -->
  <Window.Resources>
    <v:EqualsConverter x:Key="Is" />
    <v:AppIconConverter x:Key="AppIcon" />
    <BooleanToVisibilityConverter x:Key="Shown" />
    <Style x:Key="Section" TargetType="Border">
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandLine}" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource CardCaption}">
      <Setter Property="Margin" Value="2,0,0,6" />
    </Style>
    <Style x:Key="FooterButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource BrandTextSecondary}" />
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Background="Transparent" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource BrandLine}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource BrandLine}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="12"
          CornerRadius="12"
          BorderThickness="1"
          Background="{DynamicResource BrandWindowBackground}"
          BorderBrush="{DynamicResource BrandLine}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3" />
    </Border.Effect>
    <StackPanel>
      <DockPanel Margin="16,16,16,12">
        <Button x:Name="LayoutKey"
                DockPanel.Dock="Left"
                Width="44"
                Height="44"
                Margin="0,0,10,0"
                Cursor="Hand"
                ToolTip="{l:Loc QuickSwitchLayout}"
                AutomationProperties.Name="{l:Loc QuickSwitchLayout}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border CornerRadius="9"
                      Background="{DynamicResource AccentFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource BrandSecondaryBrush}"
                      BorderThickness="0,0,0,3">
                <TextBlock Text="{Binding LanguageCode}"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding LanguageName}" Style="{StaticResource HeadingText}" FontSize="18" />
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Margin="0,1,6,0" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="#22A06B" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TrayState.Paused}">
                      <Setter Property="Fill" Value="#C98A00" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TrayState.Off}">
                      <Setter Property="Fill" Value="#8C96A6" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TrayState.SelfPaused}">
                      <Setter Property="Fill" Value="#E11D48" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding StateText}"
                       FontSize="12.5"
                       Foreground="{DynamicResource BrandTextTertiary}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <Border Style="{StaticResource Section}">
        <DockPanel>
          <ui:ToggleSwitch DockPanel.Dock="Right"
                           IsChecked="{Binding AutoCorrection}"
                           AutomationProperties.Name="{l:Loc QuickAutoCorrection}" />
          <TextBlock Text="{l:Loc QuickAutoCorrection}" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Section}"
              Visibility="{Binding HasCurrentApp, Converter={StaticResource Shown}}">
        <StackPanel>
          <TextBlock Text="{l:Loc QuickCaptionApp}" Style="{StaticResource Caption}" />
          <DockPanel>
            <ui:ToggleSwitch DockPanel.Dock="Right"
                             IsChecked="{Binding CurrentAppEnabled}"
                             AutomationProperties.Name="{Binding CurrentAppText}" />
            <Image DockPanel.Dock="Left"
                   Width="16"
                   Height="16"
                   Margin="0,0,6,0"
                   Source="{Binding CurrentAppPath, Converter={StaticResource AppIcon}}" />
            <TextBlock Text="{Binding CurrentAppText}" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Section}">
        <StackPanel>
          <TextBlock Text="{l:Loc QuickCaptionSensitivity}" Style="{StaticResource Caption}" />
          <UniformGrid Columns="3" AutomationProperties.Name="{l:Loc Sensitivity}">
            <ToggleButton x:Name="SensCautious"
                          Style="{StaticResource Segment}"
                          Content="{l:Loc SensitivityCautious}"
                          IsChecked="{Binding Sensitivity, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static det:Sensitivity.Cautious}}" />
            <ToggleButton x:Name="SensBalanced"
                          Style="{StaticResource Segment}"
                          Content="{l:Loc SensitivityBalanced}"
                          IsChecked="{Binding Sensitivity, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static det:Sensitivity.Balanced}}" />
            <ToggleButton x:Name="SensAggressive"
                          Style="{StaticResource Segment}"
                          Content="{l:Loc SensitivityAggressive}"
                          IsChecked="{Binding Sensitivity, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static det:Sensitivity.Aggressive}}" />
          </UniformGrid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Section}">
        <StackPanel>
          <TextBlock Text="{l:Loc QuickCaptionPause}" Style="{StaticResource Caption}" />
          <UniformGrid Columns="4" AutomationProperties.Name="{l:Loc MenuPause}">
            <ToggleButton x:Name="Pause15"
                          Style="{StaticResource Segment}"
                          Content="{l:Loc QuickPause15}"
                          IsChecked="{Binding ActivePause, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static vm:PausePreset.FifteenMinutes}}" />
            <ToggleButton x:Name="Pause30"
                          Style="{StaticResource Segment}"
                          Content="{l:Loc QuickPause30}"
                          IsChecked="{Binding ActivePause, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static vm:PausePreset.ThirtyMinutes}}" />
            <ToggleButton x:Name="Pause60"
                          Style="{StaticResource Segment}"
                          Content="{l:Loc QuickPause60}"
                          IsChecked="{Binding ActivePause, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static vm:PausePreset.OneHour}}" />
            <ToggleButton x:Name="Pause180"
                          Style="{StaticResource Segment}"
                          Content="{l:Loc QuickPause180}"
                          IsChecked="{Binding ActivePause, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static vm:PausePreset.ThreeHours}}" />
          </UniformGrid>
          <ToggleButton x:Name="PauseRestart"
                        Style="{StaticResource Segment}"
                        Content="{l:Loc MenuPauseUntilRestart}"
                        IsChecked="{Binding ActivePause, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static vm:PausePreset.UntilRestart}}" />
        </StackPanel>
      </Border>

      <Button x:Name="Stats"
              HorizontalAlignment="Stretch"
              Visibility="{Binding ShowStatistics, Converter={StaticResource Shown}}"
              Cursor="Hand"
              AutomationProperties.Name="{l:Loc MenuStatistics}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back"
                    Background="Transparent"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BrandLine}"
                    Padding="16,10">
              <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Right"
                               Symbol="ChevronRight24"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrandTextTertiary}" />
                <StackPanel Orientation="Horizontal">
                  <StackPanel>
                    <TextBlock Text="{Binding CorrectionsToday}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{l:Loc QuickCorrectedToday}" FontSize="12" Margin="0,0,16,0"
                               Foreground="{DynamicResource BrandTextTertiary}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding UndosToday}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{l:Loc QuickUndoneToday}" FontSize="12" Margin="0,0,16,0"
                               Foreground="{DynamicResource BrandTextTertiary}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding KeptText}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{l:Loc QuickKept}" FontSize="12" Margin="0,0,16,0"
                               Foreground="{DynamicResource BrandTextTertiary}" />
                  </StackPanel>
                </StackPanel>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource BrandSurface}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource BrandSurface}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>

      <Border Style="{StaticResource Section}">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <ui:ToggleSwitch DockPanel.Dock="Right"
                             IsChecked="{Binding PlaySwitchSound}"
                             AutomationProperties.Name="{l:Loc QuickSound}" />
            <TextBlock Text="{l:Loc QuickSound}" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel>
            <ui:ToggleSwitch DockPanel.Dock="Right"
                             IsChecked="{Binding ShowCursorIndicator}"
                             AutomationProperties.Name="{l:Loc QuickIndicator}" />
            <TextBlock Text="{l:Loc QuickIndicator}" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Border>

      <Border BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource BrandLine}"
              Background="{DynamicResource BrandSurface}"
              CornerRadius="0,0,12,12"
              Padding="8,6,8,10">
        <StackPanel>
          <UniformGrid Columns="3">
            <Button x:Name="Settings" Style="{StaticResource FooterButton}"
                    Content="{l:Loc QuickSettings}" />
            <Button x:Name="FirstSteps" Style="{StaticResource FooterButton}"
                    AutomationProperties.Name="{l:Loc MenuWelcome}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Wand24" FontSize="14" Margin="0,0,4,0" />
                <TextBlock Text="{l:Loc MenuWelcome}" />
              </StackPanel>
            </Button>
            <Button x:Name="Quit" Style="{StaticResource FooterButton}"
                    Content="{l:Loc MenuQuit}" />
          </UniformGrid>
          <TextBlock Text="{Binding HotkeyHint}"
                     HorizontalAlignment="Center"
                     FontSize="11.5"
                     Foreground="{DynamicResource BrandTextTertiary}"
                     Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
