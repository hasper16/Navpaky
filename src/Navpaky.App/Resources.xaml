<!-- The app's shared resources; App.xaml merges them, and tests load them without starting
     the app. The brand look shared with the install wizard is Navpaky.Ui's Brand.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
                    xmlns:l="clr-namespace:Navpaky.App.Localization"
                    xmlns:u="clr-namespace:Navpaky.Ui;assembly=Navpaky.Ui">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Navpaky.Ui;component/Brand.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Its icon and menu are built at run time from the tray view-model
       (Tray/TrayIconView). -->
  <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="Navpaky" />

  <!-- Entries built in code as LocalizedChoice (Localization/LocalizedChoice). -->
  <l:KeyTextConverter x:Key="KeyText" />
  <DataTemplate x:Key="LocalizedChoice">
    <TextBlock>
      <TextBlock.Text>
        <MultiBinding Converter="{StaticResource KeyText}">
          <Binding Path="Key" />
          <Binding Source="{x:Static u:Localizer.Instance}" Path="Culture" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
  </DataTemplate>
  <Style x:Key="LocalizedChoiceItem"
         TargetType="ComboBoxItem"
         BasedOn="{StaticResource {x:Type ComboBoxItem}}">
    <Setter Property="AutomationProperties.Name">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource KeyText}">
          <Binding Path="Key" />
          <Binding Source="{x:Static u:Localizer.Instance}" Path="Culture" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
