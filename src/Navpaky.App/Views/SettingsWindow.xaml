<ui:FluentWindow xmlns:u="clr-namespace:Navpaky.Ui;assembly=Navpaky.Ui"
        x:Class="Navpaky.App.Views.SettingsWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Navpaky.App.Localization"
                 xmlns:v="clr-namespace:Navpaky.App.Views"
                 Title="{u:Loc SettingsTitle}"
                 Width="900"
                 Height="640"
                 MinWidth="560"
                 MinHeight="420"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None">
  <!-- WPF UI resets Window.Background on each theme change, so the root carries the surface. -->
  <Grid Background="{DynamicResource BrandWindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <!-- As wide as the longest section name, so no language cuts one off. -->
      <ColumnDefinition Width="Auto" MinWidth="220" MaxWidth="320" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <ui:TitleBar x:Name="TitleBar"
                 Grid.Row="0"
                 Grid.ColumnSpan="2"
                 Title="{u:Loc SettingsTitle}" />
    <Border Grid.Row="0"
            Grid.ColumnSpan="2"
            BorderBrush="{DynamicResource BrandLine}"
            BorderThickness="0,0,0,1"
            IsHitTestVisible="False" />
    <!-- A ListBox rather than WPF UI's NavigationView: its items expose selection to screen
         readers and follow the arrow keys (design D3). -->
    <!-- WPF UI's ListBox template draws neither its background nor its border. -->
    <Border Grid.Row="1"
            Grid.Column="0"
            Background="{DynamicResource BrandSurface}"
            BorderBrush="{DynamicResource BrandLine}"
            BorderThickness="0,0,1,0" />
    <ListBox x:Name="Sections"
             Grid.Row="1"
             Grid.Column="0"
             Margin="0"
             Padding="8,12"
             Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.Name="{u:Loc SettingsTitle}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="4,6">
            <v:DecorativeIcon DockPanel.Dock="Left" Symbol="{Binding Icon}" Margin="0,0,12,0" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
              <TextBlock.Text>
                <MultiBinding Converter="{StaticResource KeyText}">
                  <Binding Path="TitleKey" />
                  <Binding Source="{x:Static u:Localizer.Instance}" Path="Culture" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <!-- The prototype's selection: a lighter row with an accent bar on the left. -->
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Grid Margin="0,1">
                  <Border x:Name="Row"
                          CornerRadius="6"
                          Background="Transparent"
                          Padding="8,2">
                    <ContentPresenter />
                  </Border>
                  <Border x:Name="Bar"
                          Width="3"
                          Margin="0,9"
                          HorizontalAlignment="Left"
                          CornerRadius="2"
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          Visibility="Collapsed" />
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandWindowBackground}" />
                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandWindowBackground}" />
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Row" Property="BorderThickness" Value="1" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="AutomationProperties.Name">
            <Setter.Value>
              <MultiBinding Converter="{StaticResource KeyText}">
                <Binding Path="TitleKey" />
                <Binding Source="{x:Static u:Localizer.Instance}" Path="Culture" />
              </MultiBinding>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>
    <!-- Every section on one scrolling page (design D6 of redesign-visual-identity). -->
    <ScrollViewer x:Name="Scroller"
                  Grid.Row="1"
                  Grid.Column="1"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False">
      <StackPanel x:Name="PageStack" Margin="0,0,0,24" />
    </ScrollViewer>
  </Grid>
</ui:FluentWindow>
