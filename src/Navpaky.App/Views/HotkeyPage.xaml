<UserControl x:Class="Navpaky.App.Views.HotkeyPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Navpaky.App.Localization">
  <!-- A card, as in the approved prototype (fix-redesign-findings); the choices are keycap pills. -->
  <Border x:Name="Card" Style="{StaticResource SettingsCard}">
    <StackPanel x:Name="Body" Margin="16,12">
      <TextBlock x:Name="Intro"
                 Text="{l:Loc HotkeyIntro}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10" />
      <WrapPanel x:Name="Options" AutomationProperties.LabeledBy="{Binding ElementName=Intro}" />
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <TextBox x:Name="Recorder"
                 MinWidth="200"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="False"
                 AutomationProperties.Name="{l:Loc HotkeyCustom}" />
        <Button x:Name="Record"
                Content="{l:Loc HotkeyRecord}"
                Margin="8,0,0,0" />
      </StackPanel>
      <Border x:Name="Conflict"
              Visibility="Collapsed"
              BorderThickness="1"
              BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
              Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
              CornerRadius="4"
              Padding="12"
              Margin="0,10,0,0">
        <StackPanel>
          <TextBlock x:Name="ConflictText" TextWrapping="Wrap" Focusable="True" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="UseAnyway" Content="{l:Loc HotkeyUseAnyway}" />
            <Button x:Name="PickAnother"
                    Content="{l:Loc HotkeyPickAnother}"
                    Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
