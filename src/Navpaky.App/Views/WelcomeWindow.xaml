<ui:FluentWindow xmlns:u="clr-namespace:Navpaky.Ui;assembly=Navpaky.Ui"
        x:Class="Navpaky.App.Views.WelcomeWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Navpaky.App.Localization"
                 xmlns:v="clr-namespace:Navpaky.App.Views"
                 Title="{u:Loc WelcomeTitle}"
                 Width="580"
                 SizeToContent="Height"
                 MaxHeight="760"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None">
  <!-- The compact three-step welcome of the approved prototype (fix-redesign-findings). -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Shown" />
    <Style x:Key="StepBar" TargetType="Border">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Background" Value="{DynamicResource BrandLine}" />
    </Style>
  </Window.Resources>
  <!-- WPF UI resets Window.Background on each theme change, so the root carries the surface. -->
  <Grid Background="{DynamicResource BrandWindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Navpaky" ShowMaximize="False" />
    <Border Grid.Row="0"
            BorderBrush="{DynamicResource BrandLine}"
            BorderThickness="0,0,0,1"
            IsHitTestVisible="False" />
    <DockPanel Grid.Row="1" Margin="24,8,24,14">
      <Image x:Name="Mark"
             DockPanel.Dock="Left"
             Width="64"
             Height="64"
             Margin="0,0,14,0"
             AutomationProperties.Name="Navpaky" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{u:Loc WelcomeHeading}"
                   Style="{StaticResource HeadingText}"
                   FontSize="28"
                   Focusable="True" />
        <TextBlock Text="{u:Loc WelcomeTagline}"
                   Foreground="{DynamicResource BrandTextSecondary}"
                   Focusable="True" />
      </StackPanel>
    </DockPanel>
    <UniformGrid x:Name="StepBars" Grid.Row="2" Columns="3" Margin="21,0,21,8">
      <Border Style="{StaticResource StepBar}" />
      <Border Style="{StaticResource StepBar}" />
      <Border Style="{StaticResource StepBar}" />
    </UniformGrid>
    <ScrollViewer x:Name="Scroller"
                  Grid.Row="3"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False">
      <Grid Margin="24,6,24,18">
        <!-- Step 1: what Navpaky does, with a live example and Undo. -->
        <StackPanel x:Name="Step0">
          <!-- Installed without the wizard: the interface language, switched at once. -->
          <Border x:Name="LanguageChoice"
                  Style="{StaticResource SettingsCard}"
                  Padding="12,10"
                  Margin="0,0,0,14"
                  Visibility="{Binding AsksInstallQuestions, Converter={StaticResource Shown}}">
            <WrapPanel>
              <TextBlock Text="{u:Loc UiLanguageChoice}"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"
                         FontSize="13"
                         Foreground="{DynamicResource BrandTextSecondary}" />
              <RadioButton GroupName="Language"
                           Style="{StaticResource PillRadio}"
                           Content="{u:Loc UiLanguageSystem}"
                           IsChecked="{Binding UsesSystemLanguage}" />
              <RadioButton GroupName="Language"
                           Style="{StaticResource PillRadio}"
                           Content="{u:Loc UiLanguageEnglish}"
                           IsChecked="{Binding UsesEnglish}" />
              <RadioButton GroupName="Language"
                           Style="{StaticResource PillRadio}"
                           Content="{u:Loc UiLanguageUkrainian}"
                           IsChecked="{Binding UsesUkrainian}" />
            </WrapPanel>
          </Border>
          <TextBlock Text="{u:Loc WelcomeWhatTitle}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Margin="0,0,0,8"
                     Focusable="True" />
          <TextBlock Text="{u:Loc WelcomeWhatText}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource BrandTextSecondary}"
                     Margin="0,0,0,12"
                     Focusable="True" />
          <Border Style="{StaticResource SettingsCard}" Padding="16,12">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Keycap}">
                <TextBlock x:Name="DemoKey" FontWeight="SemiBold" FontSize="12" />
              </Border>
              <TextBlock x:Name="DemoWord"
                         FontSize="20"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="{u:Loc WelcomeWhatTitle}" />
            </DockPanel>
          </Border>
          <WrapPanel Margin="0,2,0,6">
            <TextBlock Text="{u:Loc WelcomeUndoBefore}"
                       VerticalAlignment="Center"
                       FontSize="13" />
            <Border Style="{StaticResource Keycap}" Margin="4,0">
              <TextBlock Text="{u:Loc KeyCtrl}" FontWeight="SemiBold" FontSize="12" />
            </Border>
            <TextBlock x:Name="UndoPlus" VerticalAlignment="Center" FontSize="13" />
            <Border Style="{StaticResource Keycap}" Margin="4,0">
              <TextBlock x:Name="UndoKey" FontWeight="SemiBold" FontSize="12" />
            </Border>
            <TextBlock Text="{u:Loc WelcomeUndoAfter}"
                       VerticalAlignment="Center"
                       FontSize="13" />
          </WrapPanel>
        </StackPanel>

        <!-- Step 2: try it. -->
        <StackPanel x:Name="Step1" Visibility="Collapsed">
          <TextBlock Text="{u:Loc WelcomeTryItTitle}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Margin="0,0,0,8"
                     Focusable="True" />
          <Border Visibility="{Binding NeedsAnotherLayout, Converter={StaticResource Shown}}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                  Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                  CornerRadius="6"
                  Padding="12"
                  Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="{u:Loc WelcomeOneLayout}"
                         TextWrapping="Wrap"
                         Focusable="True" />
              <Button x:Name="LanguageSettings"
                      Content="{u:Loc WelcomeLanguageSettings}"
                      Margin="0,12,0,0" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="TryItHint"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource BrandTextSecondary}"
                     Focusable="True"
                     Margin="0,0,0,10" />
          <TextBox x:Name="TryIt"
                   FontSize="16"
                   Padding="10,8"
                   AutomationProperties.Name="{u:Loc WelcomeTryItField}"
                   AutomationProperties.HelpText="{Binding Text, ElementName=TryItHint}" />
          <TextBlock x:Name="TryItWorked"
                     Text="{u:Loc WelcomeTryItWorked}"
                     Visibility="{Binding TryItWorked, Converter={StaticResource Shown}}"
                     Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                     TextWrapping="Wrap"
                     Focusable="True"
                     AutomationProperties.LiveSetting="Polite"
                     Margin="0,8,0,0" />
          <TextBlock Text="{u:Loc WelcomePrivacyField}"
                     FontSize="12.5"
                     Foreground="{DynamicResource BrandTextTertiary}"
                     Margin="0,10,0,0"
                     Focusable="True" />
        </StackPanel>

        <!-- Step 3: your choices. -->
        <StackPanel x:Name="Step2" Visibility="Collapsed">
          <TextBlock Text="{u:Loc WelcomeChoicesTitle}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Margin="0,0,0,8"
                     Focusable="True" />
          <!-- The prototype's last step (owner decision): the Hotkey with every option of Settings,
               the tray tip, crash reports. -->
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <!-- The Hotkey page's own options, so the choice works as in Settings. -->
              <Border BorderThickness="0,0,0,1"
                      BorderBrush="{DynamicResource BrandLine}"
                      Padding="16,12">
                <StackPanel>
                  <TextBlock x:Name="HotkeyLabel" Text="{u:Loc PageHotkey}" />
                  <TextBlock Text="{u:Loc WelcomeHotkeyHint}"
                             FontSize="12.5"
                             Foreground="{DynamicResource BrandTextTertiary}" />
                  <ContentControl x:Name="Hotkey" Focusable="False" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
              <u:SettingRow Label="{u:Loc WelcomeTelemetry}" Hint="{u:Loc WelcomeTelemetryHint}">
                <ui:ToggleSwitch IsChecked="{Binding TelemetryAgreed}"
                                 AutomationProperties.Name="{u:Loc WelcomeTelemetry}" />
              </u:SettingRow>
              <u:SettingRow Label="{u:Loc LaunchAtSignIn}"
                            Visibility="{Binding AsksInstallQuestions, Converter={StaticResource Shown}}">
                <ui:ToggleSwitch IsChecked="{Binding LaunchAtSignIn}"
                                 AutomationProperties.Name="{u:Loc LaunchAtSignIn}" />
              </u:SettingRow>
              <u:SettingRow Label="{u:Loc WelcomeShortcut}"
                            Hint="{u:Loc WelcomeShortcutHint}"
                            Visibility="{Binding AsksInstallQuestions, Converter={StaticResource Shown}}">
                <ui:ToggleSwitch IsChecked="{Binding DesktopShortcut}"
                                 AutomationProperties.Name="{u:Loc WelcomeShortcut}" />
              </u:SettingRow>
              <u:SettingRow Label="{u:Loc WelcomeTrayTitle}" Hint="{u:Loc WelcomeTrayTip}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="4"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BrandLine}"
            Background="{DynamicResource BrandSurface}"
            Padding="24,12">
      <DockPanel>
        <ui:Button x:Name="Back"
                   DockPanel.Dock="Left"
                   Content="{u:Loc WelcomeBack}"
                   MinWidth="90" />
        <ui:Button x:Name="Done"
                   DockPanel.Dock="Right"
                   Content="{u:Loc WelcomeDone}"
                   Appearance="Primary"
                   MinWidth="100" />
        <ui:Button x:Name="Next"
                   DockPanel.Dock="Right"
                   Content="{u:Loc WelcomeNext}"
                   Appearance="Primary"
                   MinWidth="100" />
        <TextBlock x:Name="StepText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource BrandTextTertiary}" />
      </DockPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
