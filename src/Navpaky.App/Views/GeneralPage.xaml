<UserControl xmlns:u="clr-namespace:Navpaky.Ui;assembly=Navpaky.Ui"
        x:Class="Navpaky.App.Views.GeneralPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Navpaky.App.Localization"
             xmlns:v="clr-namespace:Navpaky.App.Views">
  <!-- Cards of rows, as in the approved prototype (fix-redesign-findings). -->
  <StackPanel>
    <Border Style="{StaticResource SettingsCard}">
      <StackPanel>
        <u:SettingRow Label="{u:Loc LaunchAtSignIn}">
          <ui:ToggleSwitch IsChecked="{Binding LaunchAtSignIn}"
                           AutomationProperties.Name="{u:Loc LaunchAtSignIn}" />
        </u:SettingRow>
        <u:SettingRow Label="{u:Loc AutoCheckForUpdates}">
          <ui:ToggleSwitch IsChecked="{Binding AutoCheckForUpdates}"
                           AutomationProperties.Name="{u:Loc AutoCheckForUpdates}" />
        </u:SettingRow>
        <u:SettingRow Label="{u:Loc UiLanguageChoice}">
          <ComboBox x:Name="Languages"
                    MinWidth="150"
                    AutomationProperties.Name="{u:Loc UiLanguageChoice}"
                    ItemTemplate="{StaticResource LocalizedChoice}"
                    ItemContainerStyle="{StaticResource LocalizedChoiceItem}"
                    SelectedValue="{Binding UiLanguage}"
                    SelectedValuePath="Value" />
        </u:SettingRow>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource SettingsCard}">
      <StackPanel>
        <u:SettingRow Label="{u:Loc ShowCursorIndicator}" Hint="{u:Loc ShowCursorIndicatorHint}">
          <ui:ToggleSwitch IsChecked="{Binding ShowCursorIndicator}"
                           AutomationProperties.Name="{u:Loc ShowCursorIndicator}" />
        </u:SettingRow>
        <u:SettingRow Label="{u:Loc CursorIndicatorStyleChoice}">
          <!-- One choice per style, each with a preview of the mark (built in code). -->
          <StackPanel x:Name="IndicatorStyles"
                      Orientation="Horizontal"
                      AutomationProperties.Name="{u:Loc CursorIndicatorStyleChoice}" />
        </u:SettingRow>
        <u:SettingRow Label="{u:Loc PlaySwitchSound}">
          <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="Sounds"
                      MinWidth="130"
                      AutomationProperties.Name="{u:Loc SwitchSoundChoice}"
                      ItemTemplate="{StaticResource LocalizedChoice}"
                      ItemContainerStyle="{StaticResource LocalizedChoiceItem}"
                      SelectedValue="{Binding SwitchSound}"
                      SelectedValuePath="Value" />
            <Button x:Name="Preview"
                    MinWidth="40"
                    Margin="8,0"
                    ToolTip="{u:Loc PreviewSound}"
                    AutomationProperties.Name="{u:Loc PreviewSound}">
              <ui:SymbolIcon Symbol="Play24" />
            </Button>
            <ui:ToggleSwitch x:Name="PlaySound"
                             IsChecked="{Binding PlaySwitchSound}"
                             AutomationProperties.Name="{u:Loc PlaySwitchSound}" />
          </StackPanel>
        </u:SettingRow>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
