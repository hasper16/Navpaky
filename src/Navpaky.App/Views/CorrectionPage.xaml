<UserControl xmlns:u="clr-namespace:Navpaky.Ui;assembly=Navpaky.Ui"
        x:Class="Navpaky.App.Views.CorrectionPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Navpaky.App.Localization"
             xmlns:detection="clr-namespace:Navpaky.Core.Detection;assembly=Navpaky.Core"
             xmlns:v="clr-namespace:Navpaky.App.Views">
  <UserControl.Resources>
    <v:EqualsConverter x:Key="Equals" />
  </UserControl.Resources>
  <!-- Cards of rows, as in the approved prototype (fix-redesign-findings). -->
  <StackPanel>
    <Border Style="{StaticResource SettingsCard}">
      <StackPanel>
        <u:SettingRow Label="{u:Loc AutoCorrection}">
          <ui:ToggleSwitch IsChecked="{Binding AutoCorrectionEnabled}"
                           AutomationProperties.Name="{u:Loc AutoCorrection}" />
        </u:SettingRow>
        <u:SettingRow Label="{u:Loc Sensitivity}" Hint="{Binding SensitivityHint}">
          <StackPanel Orientation="Horizontal" AutomationProperties.Name="{u:Loc Sensitivity}">
            <RadioButton Style="{StaticResource PillRadio}"
                         GroupName="Sensitivity"
                         Content="{u:Loc SensitivityCautious}"
                         IsChecked="{Binding Sensitivity, Converter={StaticResource Equals},
                                     ConverterParameter={x:Static detection:Sensitivity.Cautious}}" />
            <RadioButton Style="{StaticResource PillRadio}"
                         GroupName="Sensitivity"
                         Content="{u:Loc SensitivityBalanced}"
                         IsChecked="{Binding Sensitivity, Converter={StaticResource Equals},
                                     ConverterParameter={x:Static detection:Sensitivity.Balanced}}" />
            <RadioButton Style="{StaticResource PillRadio}"
                         GroupName="Sensitivity"
                         Content="{u:Loc SensitivityAggressive}"
                         IsChecked="{Binding Sensitivity, Converter={StaticResource Equals},
                                     ConverterParameter={x:Static detection:Sensitivity.Aggressive}}" />
          </StackPanel>
        </u:SettingRow>
        <u:SettingRow Label="{u:Loc CorrectWhenIPress}">
          <StackPanel Orientation="Horizontal" AutomationProperties.Name="{u:Loc CorrectWhenIPress}">
            <CheckBox Style="{StaticResource PillCheck}"
                      Content="{u:Loc TriggerSpace}"
                      IsChecked="{Binding TriggerOnSpace}" />
            <CheckBox Style="{StaticResource PillCheck}"
                      Content="{u:Loc TriggerEnter}"
                      IsChecked="{Binding TriggerOnEnter}" />
            <CheckBox Style="{StaticResource PillCheck}"
                      Content="{u:Loc TriggerTab}"
                      IsChecked="{Binding TriggerOnTab}" />
          </StackPanel>
        </u:SettingRow>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource SettingsCard}">
      <StackPanel>
        <u:SettingRow Label="{u:Loc SkipAfterManualSwitch}" Hint="{u:Loc SkipAfterManualSwitchHint}">
          <ui:ToggleSwitch IsChecked="{Binding SkipAfterManualLayoutSwitch}"
                           AutomationProperties.Name="{u:Loc SkipAfterManualSwitch}" />
        </u:SettingRow>
        <u:SettingRow Label="{u:Loc VerifiedReplacement}" Hint="{u:Loc VerifiedReplacementHint}">
          <ui:ToggleSwitch IsChecked="{Binding VerifiedReplacement}"
                           AutomationProperties.Name="{u:Loc VerifiedReplacement}" />
        </u:SettingRow>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
