<UserControl x:Class="Navpaky.App.Views.CorrectionPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Navpaky.App.Localization"
             xmlns:detection="clr-namespace:Navpaky.Core.Detection;assembly=Navpaky.Core"
             xmlns:views="clr-namespace:Navpaky.App.Views">
  <UserControl.Resources>
    <views:EqualsConverter x:Key="Equals" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,16" MaxWidth="640" HorizontalAlignment="Left">
      <ui:ToggleSwitch Content="{l:Loc AutoCorrection}"
                       IsChecked="{Binding AutoCorrectionEnabled}"
                       Margin="0,0,0,16" />
      <TextBlock x:Name="SensitivityLabel"
                 Text="{l:Loc Sensitivity}"
                 Style="{StaticResource SectionText}" />
      <StackPanel AutomationProperties.LabeledBy="{Binding ElementName=SensitivityLabel}"
                  Margin="0,0,0,16">
        <RadioButton GroupName="Sensitivity"
                     Content="{l:Loc SensitivityBalanced}"
                     IsChecked="{Binding Sensitivity, Converter={StaticResource Equals},
                                 ConverterParameter={x:Static detection:Sensitivity.Balanced}}" />
        <TextBlock Text="{l:Loc SensitivityBalancedHint}"
                   Style="{StaticResource OptionHintText}" />
        <RadioButton GroupName="Sensitivity"
                     Content="{l:Loc SensitivityCautious}"
                     IsChecked="{Binding Sensitivity, Converter={StaticResource Equals},
                                 ConverterParameter={x:Static detection:Sensitivity.Cautious}}" />
        <TextBlock Text="{l:Loc SensitivityCautiousHint}"
                   Style="{StaticResource OptionHintText}" />
        <RadioButton GroupName="Sensitivity"
                     Content="{l:Loc SensitivityAggressive}"
                     IsChecked="{Binding Sensitivity, Converter={StaticResource Equals},
                                 ConverterParameter={x:Static detection:Sensitivity.Aggressive}}" />
        <TextBlock Text="{l:Loc SensitivityAggressiveHint}"
                   Style="{StaticResource OptionHintText}" />
      </StackPanel>
      <TextBlock x:Name="TriggerLabel"
                 Text="{l:Loc CorrectWhenIPress}"
                 Style="{StaticResource SectionText}" />
      <StackPanel Orientation="Horizontal"
                  AutomationProperties.LabeledBy="{Binding ElementName=TriggerLabel}"
                  Margin="0,0,0,16">
        <CheckBox Content="{l:Loc TriggerSpace}"
                  IsChecked="{Binding TriggerOnSpace}"
                  Margin="0,0,16,0" />
        <CheckBox Content="{l:Loc TriggerEnter}"
                  IsChecked="{Binding TriggerOnEnter}"
                  Margin="0,0,16,0" />
        <CheckBox Content="{l:Loc TriggerTab}"
                  IsChecked="{Binding TriggerOnTab}" />
      </StackPanel>
      <ui:ToggleSwitch Content="{l:Loc SkipAfterManualSwitch}"
                       IsChecked="{Binding SkipAfterManualLayoutSwitch}" />
      <TextBlock Text="{l:Loc SkipAfterManualSwitchHint}"
                 Style="{StaticResource HintText}"
                 Margin="0,4,0,16" />
      <ui:ToggleSwitch Content="{l:Loc VerifiedReplacement}"
                       IsChecked="{Binding VerifiedReplacement}" />
      <TextBlock Text="{l:Loc VerifiedReplacementHint}"
                 Style="{StaticResource HintText}"
                 Margin="0,4,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
