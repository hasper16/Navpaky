<UserControl xmlns:u="clr-namespace:Navpaky.Ui;assembly=Navpaky.Ui"
        x:Class="Navpaky.App.Views.AboutPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Navpaky.App.Localization">
  <!-- A card with the mark, as in the approved prototype (fix-redesign-findings). -->
  <Border Style="{StaticResource SettingsCard}">
    <DockPanel Margin="16">
      <Image x:Name="Mark"
             DockPanel.Dock="Left"
             Width="64"
             Height="64"
             Margin="0,0,18,0"
             AutomationProperties.Name="Navpaky" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Navpaky" Style="{StaticResource HeadingText}" FontSize="22" />
        <TextBlock Text="{u:Loc AboutTagline}"
                   Margin="0,2,0,0"
                   Foreground="{DynamicResource BrandTextSecondary}"
                   Focusable="True" />
        <TextBlock x:Name="Version"
                   Style="{StaticResource HintText}"
                   Foreground="{DynamicResource BrandTextTertiary}"
                   Focusable="True" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
