<UserControl x:Class="Navpaky.App.Views.AboutPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Navpaky.App.Localization">
  <StackPanel Margin="24,16" HorizontalAlignment="Left">
    <Image x:Name="Mark"
           Width="64"
           Height="64"
           HorizontalAlignment="Left"
           Margin="0,0,0,16"
           AutomationProperties.Name="Navpaky" />
    <TextBlock Text="Navpaky" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="{l:Loc AboutTagline}" Margin="0,4,0,8" Focusable="True" />
    <TextBlock x:Name="Version" Style="{StaticResource HintText}" Focusable="True" />
  </StackPanel>
</UserControl>
