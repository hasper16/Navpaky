<UserControl xmlns:u="clr-namespace:Navpaky.Ui;assembly=Navpaky.Ui"
        x:Class="Navpaky.App.Views.AppsAndWordsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Navpaky.App.Localization"
             xmlns:views="clr-namespace:Navpaky.App.Views">
  <!-- As prototype v24 (fix-redesign-findings, design D9): the apps as rows, the words as chips;
       Add on a word row opens the field that adds a word. -->
  <UserControl.Resources>
    <views:FormatConverter x:Key="Format" />
    <views:AppIconConverter x:Key="AppIcon" />
    <Style x:Key="WordChip" TargetType="Border">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandLine}" />
      <Setter Property="Background" Value="{DynamicResource BrandWindowBackground}" />
      <Setter Property="Padding" Value="8,1,1,1" />
      <Setter Property="Margin" Value="6,3,0,3" />
    </Style>
    <Style x:Key="WordText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ChipRemove" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <ItemsPanelTemplate x:Key="Chips">
      <WrapPanel HorizontalAlignment="Right" />
    </ItemsPanelTemplate>
    <Style x:Key="WordRow" TargetType="Border">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandLine}" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Border Style="{StaticResource SettingsCard}">
      <StackPanel>
        <DockPanel Margin="16,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <ui:Button x:Name="AddRunning" Content="{u:Loc AddRunningApp}" />
            <ui:Button x:Name="Browse" Content="{u:Loc BrowseForApp}" Margin="8,0,0,0" />
          </StackPanel>
          <TextBlock x:Name="AppsLabel"
                     Text="{u:Loc ExcludedApps}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0" />
        </DockPanel>
        <ItemsControl x:Name="Apps"
                      ItemsSource="{Binding Apps}"
                      Focusable="False"
                      AutomationProperties.LabeledBy="{Binding ElementName=AppsLabel}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderThickness="0,1,0,0"
                      BorderBrush="{DynamicResource BrandLine}"
                      Padding="16,6">
                <DockPanel>
                  <ui:Button DockPanel.Dock="Right"
                             Appearance="Transparent"
                             BorderThickness="0"
                             Content="{u:Loc Remove}"
                             Foreground="{DynamicResource BrandTextTertiary}"
                             FontSize="12"
                             Tag="{Binding}"
                             Click="OnRemoveApp">
                    <AutomationProperties.Name>
                      <MultiBinding Converter="{StaticResource Format}"
                                    ConverterParameter="RemoveItem">
                        <Binding Path="Name" />
                        <Binding Source="{x:Static u:Localizer.Instance}" Path="Culture" />
                      </MultiBinding>
                    </AutomationProperties.Name>
                  </ui:Button>
                  <Image Source="{Binding Key, Converter={StaticResource AppIcon}}"
                         Width="20"
                         Height="20"
                         Margin="0,0,10,0" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource SettingsCard}">
      <StackPanel>
        <Border Style="{StaticResource WordRow}">
          <StackPanel>
            <DockPanel>
              <ui:Button x:Name="OpenProtected"
                         DockPanel.Dock="Right"
                         Content="{u:Loc Add}"
                         Margin="10,0,0,0"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="ProtectedLabel"
                         DockPanel.Dock="Left"
                         Text="{u:Loc ProtectedWords}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         MaxWidth="260" />
              <ItemsControl x:Name="ProtectedList"
                            ItemsSource="{Binding Protected}"
                            ItemsPanel="{StaticResource Chips}"
                            Focusable="False"
                            AutomationProperties.LabeledBy="{Binding ElementName=ProtectedLabel}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource WordChip}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding}" Style="{StaticResource WordText}" />
                        <ui:Button Style="{StaticResource ChipRemove}"
                                   Tag="{Binding}"
                                   Click="OnRemoveProtected">
                          <ui:SymbolIcon Symbol="Dismiss12"
                                         FontSize="10"
                                         Foreground="{DynamicResource BrandTextTertiary}" />
                          <AutomationProperties.Name>
                            <MultiBinding Converter="{StaticResource Format}"
                                          ConverterParameter="RemoveItem">
                              <Binding />
                              <Binding Source="{x:Static u:Localizer.Instance}" Path="Culture" />
                            </MultiBinding>
                          </AutomationProperties.Name>
                        </ui:Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
            <WrapPanel x:Name="ProtectedEditor"
                       HorizontalAlignment="Right"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
              <TextBox x:Name="NewProtected"
                       MinWidth="200"
                       Margin="0,0,0,4"
                       AutomationProperties.Name="{u:Loc NewWord}" />
              <ui:Button x:Name="AddProtected"
                         Content="{u:Loc Add}"
                         Appearance="Primary"
                         Margin="8,0,0,4" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource WordRow}" BorderThickness="0">
          <StackPanel>
            <DockPanel>
              <ui:Button x:Name="OpenLearned"
                         DockPanel.Dock="Right"
                         Content="{u:Loc Add}"
                         Margin="10,0,0,0"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="LearnedLabel"
                         DockPanel.Dock="Left"
                         Text="{u:Loc LearnedWords}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         MaxWidth="260" />
              <ItemsControl x:Name="LearnedList"
                            ItemsSource="{Binding Learned}"
                            ItemsPanel="{StaticResource Chips}"
                            Focusable="False"
                            AutomationProperties.LabeledBy="{Binding ElementName=LearnedLabel}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource WordChip}">
                      <Border.ToolTip>
                        <MultiBinding Converter="{StaticResource KeyText}">
                          <Binding Path="LanguageKey" />
                          <Binding Source="{x:Static u:Localizer.Instance}" Path="Culture" />
                        </MultiBinding>
                      </Border.ToolTip>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Text}" Style="{StaticResource WordText}" />
                        <ui:Button Style="{StaticResource ChipRemove}"
                                   Tag="{Binding}"
                                   Click="OnRemoveLearned">
                          <ui:SymbolIcon Symbol="Dismiss12"
                                         FontSize="10"
                                         Foreground="{DynamicResource BrandTextTertiary}" />
                          <AutomationProperties.Name>
                            <MultiBinding Converter="{StaticResource Format}"
                                          ConverterParameter="RemoveItem">
                              <Binding Path="Text" />
                              <Binding Source="{x:Static u:Localizer.Instance}" Path="Culture" />
                            </MultiBinding>
                          </AutomationProperties.Name>
                        </ui:Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
            <WrapPanel x:Name="LearnedEditor"
                       HorizontalAlignment="Right"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
              <TextBox x:Name="NewLearned"
                       MinWidth="200"
                       Margin="0,0,0,4"
                       AutomationProperties.Name="{u:Loc NewWord}" />
              <ComboBox x:Name="LearnedLanguage"
                        MinWidth="120"
                        Margin="8,0,0,4"
                        AutomationProperties.Name="{u:Loc WordLanguage}"
                        ItemTemplate="{StaticResource LocalizedChoice}"
                        ItemContainerStyle="{StaticResource LocalizedChoiceItem}"
                        SelectedValuePath="Value" />
              <ui:Button x:Name="AddLearned"
                         Content="{u:Loc Add}"
                         Appearance="Primary"
                         Margin="8,0,0,4" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
