<UserControl x:Class="Navpaky.App.Views.AppsAndWordsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Navpaky.App.Localization"
             xmlns:views="clr-namespace:Navpaky.App.Views">
  <UserControl.Resources>
    <views:FormatConverter x:Key="Format" />
    <views:AppIconConverter x:Key="AppIcon" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,16" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock x:Name="AppsLabel"
                 Text="{l:Loc ExcludedApps}"
                 Style="{StaticResource SectionText}" />
      <ItemsControl x:Name="Apps"
                    ItemsSource="{Binding Apps}"
                    Focusable="False"
                    AutomationProperties.LabeledBy="{Binding ElementName=AppsLabel}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,2">
              <Button DockPanel.Dock="Right"
                      Content="{l:Loc Remove}"
                      Tag="{Binding}"
                      Click="OnRemoveApp">
                <AutomationProperties.Name>
                  <MultiBinding Converter="{StaticResource Format}" ConverterParameter="RemoveItem">
                    <Binding Path="Name" />
                    <Binding Source="{x:Static l:Localizer.Instance}" Path="Culture" />
                  </MultiBinding>
                </AutomationProperties.Name>
              </Button>
              <Image Source="{Binding Key, Converter={StaticResource AppIcon}}"
                     Width="20"
                     Height="20"
                     Margin="0,0,8,0" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,24">
        <Button x:Name="AddRunning" Content="{l:Loc AddRunningApp}" />
        <Button x:Name="Browse" Content="{l:Loc BrowseForApp}" Margin="8,0,0,0" />
      </StackPanel>

      <TextBlock x:Name="ProtectedLabel"
                 Text="{l:Loc ProtectedWords}"
                 Style="{StaticResource SectionText}" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBox x:Name="NewProtected"
                 MinWidth="200"
                 AutomationProperties.Name="{l:Loc NewWord}" />
        <Button x:Name="AddProtected" Content="{l:Loc Add}" Margin="8,0,0,0" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Protected}"
                    Focusable="False"
                    AutomationProperties.LabeledBy="{Binding ElementName=ProtectedLabel}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,2">
              <Button DockPanel.Dock="Right"
                      Content="{l:Loc Remove}"
                      Tag="{Binding}"
                      Click="OnRemoveProtected">
                <AutomationProperties.Name>
                  <MultiBinding Converter="{StaticResource Format}" ConverterParameter="RemoveItem">
                    <Binding />
                    <Binding Source="{x:Static l:Localizer.Instance}" Path="Culture" />
                  </MultiBinding>
                </AutomationProperties.Name>
              </Button>
              <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock x:Name="LearnedLabel"
                 Text="{l:Loc LearnedWords}"
                 Style="{StaticResource SectionText}"
                 Margin="0,24,0,8" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBox x:Name="NewLearned"
                 MinWidth="200"
                 AutomationProperties.Name="{l:Loc NewWord}" />
        <ComboBox x:Name="LearnedLanguage"
                  MinWidth="120"
                  Margin="8,0,0,0"
                  AutomationProperties.Name="{l:Loc WordLanguage}"
                  ItemTemplate="{StaticResource LocalizedChoice}"
                  ItemContainerStyle="{StaticResource LocalizedChoiceItem}"
                  SelectedValuePath="Value" />
        <Button x:Name="AddLearned" Content="{l:Loc Add}" Margin="8,0,0,0" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Learned}"
                    Focusable="False"
                    AutomationProperties.LabeledBy="{Binding ElementName=LearnedLabel}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,2">
              <Button DockPanel.Dock="Right"
                      Content="{l:Loc Remove}"
                      Tag="{Binding}"
                      Click="OnRemoveLearned">
                <AutomationProperties.Name>
                  <MultiBinding Converter="{StaticResource Format}" ConverterParameter="RemoveItem">
                    <Binding Path="Text" />
                    <Binding Source="{x:Static l:Localizer.Instance}" Path="Culture" />
                  </MultiBinding>
                </AutomationProperties.Name>
              </Button>
              <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource HintText}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource KeyText}">
                    <Binding Path="LanguageKey" />
                    <Binding Source="{x:Static l:Localizer.Instance}" Path="Culture" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
