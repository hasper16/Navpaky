<ui:FluentWindow x:Class="Navpaky.App.Views.ExportWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Navpaky.App.Localization"
                 Title="{l:Loc ExportTitle}"
                 Width="720"
                 Height="560"
                 MinWidth="480"
                 MinHeight="360"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="TitleBar" Title="{l:Loc ExportTitle}" />
    <StackPanel Grid.Row="1" Margin="24,8,24,8">
      <TextBlock Text="{l:Loc ExportNote}"
                 Style="{StaticResource HintText}"
                 Margin="0,0,0,8"
                 Focusable="True" />
      <CheckBox Content="{l:Loc ExportIncludeLog}"
                IsChecked="{Binding IncludeAnalysisLog}" />
    </StackPanel>
    <!-- The themed text box shows no horizontal scroll bar, so long lines were cut off: it
         takes the text's full size and this viewer scrolls it. -->
    <ScrollViewer Grid.Row="2"
                  Margin="24,0,24,8"
                  Focusable="False"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
      <TextBox x:Name="PreviewBox"
               Text="{Binding Preview, Mode=OneWay}"
               IsReadOnly="True"
               FontFamily="Consolas"
               TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Disabled"
               HorizontalScrollBarVisibility="Disabled"
               AutomationProperties.Name="{l:Loc ExportTitle}" />
    </ScrollViewer>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="24,0,24,24">
      <ui:Button x:Name="SaveButton"
                 Content="{l:Loc ExportSave}"
                 Appearance="Primary"
                 Margin="0,0,8,0" />
      <ui:Button x:Name="CopyButton" Content="{l:Loc ExportCopy}" />
      <TextBlock x:Name="Status"
                 VerticalAlignment="Center"
                 Margin="16,0,0,0"
                 Style="{StaticResource HintText}"
                 Focusable="True" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
